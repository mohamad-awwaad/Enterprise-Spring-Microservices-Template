<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>microservices-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>microservices-parent</name>
    <description>Parent POM for Microservices Template</description>

    <properties>
        <java.version>25</java.version>
        <spring-boot.version>4.1.1</spring-boot.version>
    </properties>

    <modules>
        <module>common-core</module>
        <module>common-web</module>
        <module>common-security</module>
        <module>common-test</module>
        <module>dependencies-bom</module>
        <module>bff</module>
        <module>gateway</module>
        <module>profile-service</module>
        <module>order-service</module>
        <module>keycloak-admin-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>dependencies-bom</artifactId>
                <version>1.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- No dependencies are inherited by every module: each module declares what it uses,
         so common-core stays free of Spring and Lombok. -->

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                 CycloneDX SBOM for the whole reactor (target/bom.json at the repo root).
                 Version comes from spring-boot-starter-parent's own pluginManagement
                 (cyclonedx-maven-plugin.version, currently 2.9.3) - not pinned here.
                 inherited=false keeps this bound to the aggregator (root) build only: without
                 it, <build><plugins> entries are inherited into every child module's effective
                 POM, and each child would run its own makeAggregateBom at its own package
                 phase, producing a redundant (and differently-scoped) bom.json per module
                 instead of one reactor-wide SBOM.
            -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <inherited>false</inherited>
                <executions>
                    <!-- spring-boot-starter-parent's pluginManagement binds a "default" execution
                         of this same goal at generate-resources (writing to
                         target/classes/META-INF/sbom/); disable it here so only the
                         generate-sbom execution below runs, producing exactly target/bom.json. -->
                    <execution>
                        <id>default</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>generate-sbom</id>
                        <phase>package</phase>
                        <goals>
                            <goal>makeAggregateBom</goal>
                        </goals>
                        <configuration>
                            <outputFormat>json</outputFormat>
                            <outputName>bom</outputName>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
