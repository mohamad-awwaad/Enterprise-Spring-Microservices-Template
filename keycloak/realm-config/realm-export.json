
{
  "realm": "my-realm",
  "enabled": true,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(8) and notUsername",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrator"
      },
      {
        "name": "USER",
        "description": "Standard User"
      },
      {
        "name": "INTERNAL_SERVICE",
        "description": "Service-to-service calls between our own microservices (e.g. profile-service calling keycloak-admin-service's internal registration endpoint)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "admin-service-client",
      "clientAuthenticatorType": "client-secret",
      "secret": "admin-secret",
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    },
    {
      "clientId": "bff-client",
      "clientAuthenticatorType": "client-secret",
      "secret": "mysecret",
      "redirectUris": [
        "http://localhost:8081/login/oauth2/code/keycloak"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:4200/*",
        "pkce.code.challenge.method": "S256"
      },
      "publicClient": false,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "aud-mapper-template-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "template-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "internal-client",
      "clientAuthenticatorType": "client-secret",
      "secret": "my-internal-secret",
      "protocol": "openid-connect",
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "aud-mapper-template-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "template-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "test-client",
      "clientAuthenticatorType": "client-secret",
      "secret": "test-secret",
      "protocol": "openid-connect",
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "aud-mapper-template-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "template-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mobile-client",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "com.example.app://callback",
        "http://localhost:*/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "com.example.app://logout"
      },
      "protocolMappers": [
        {
          "name": "aud-mapper-template-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "template-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.com",
      "firstName": "Admin",
      "lastName": "User",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password"
        }
      ],
      "realmRoles": [
        "ADMIN",
        "default-roles-my-realm"
      ]
    },
    {
      "username": "user",
      "enabled": true,
      "email": "user@example.com",
      "firstName": "User",
      "lastName": "Name",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password"
        }
      ],
      "realmRoles": [
        "default-roles-my-realm"
      ]
    },
    {
      "username": "service-account-internal-client",
      "serviceAccountClientId": "internal-client",
      "enabled": true,
      "realmRoles": [
        "INTERNAL_SERVICE"
      ]
    },
    {
      "username": "service-account-admin-service-client",
      "serviceAccountClientId": "admin-service-client",
      "enabled": true,
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users"
        ]
      }
    }
  ]
}
